# Ignore generated environments, caches, build output, and real secrets.
# Keep application code and safe example environment files in Git.

backend/.venv/
backend/**/__pycache__/
backend/*.py[cod]
backend/db.sqlite3
backend/.env
backend/.env.*
!backend/.env.example

frontend/node_modules/
frontend/.next/
frontend/.env
frontend/.env.*
!frontend/.env.example